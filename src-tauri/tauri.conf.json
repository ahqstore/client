{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AHQ Store Neo",
  "version": "../package.json",
  "identifier": "com.ahqstore.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "connect-src 'self' http://ipc.localhost ipc:;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QzUzN0M3MzlBMTc1MzUKUldRMWRhRTV4emZGNlpTY0pCVXpNTkVqZUtleGU1bTZTeW5CNS9jZENzWFdVSTNzZER1V2hkcEEK",
      "endpoints": [
        "https://github.com/ahqstore/client/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "mobile": [{ "scheme": ["ahqstore"], "appLink": false }],
      "desktop": {
        "schemes": ["ahqstore"]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["deb", "msi", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AHQ Softwares",
    "fileAssociations": [
      {
        "ext": ["ahqstore", "astore", "astorepkg"],
        "description": "AHQ Store Package",
        "mimeType": "application/octet-stream",
        "name": "AHQ Store Package",
        "role": "Editor"
      }
    ]
  }
}
