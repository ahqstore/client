<Window x:Class="AHQStoreWin32Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AHQStoreWin32Setup"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        mc:Ignorable="d"
        Title="AHQ Store Installer"
        Height="600"
        Width="800"
        ResizeMode="NoResize"
        AllowDrop="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Closing="Window_Closing"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"
                         ProgressState="None"
                         ProgressValue="0"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <Storyboard x:Key="SlideAndFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0"
                             To="1.0"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30"
                             To="0"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Welcome"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform Y="30"/>
            </Grid.RenderTransform>
            <Image Height="175"
                   Margin="0,0,0,200"
                   Source="pack://application:,,,/Assets/splashable.png"/>

            <TextBlock Text="AHQ Store"
                       FontSize="40"
                       Margin="0,270,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Let the open sourced software revolution begin"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="14"
                       Margin="0,350,0,0"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Licensed under MIT"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="12"
                       Margin="12,12,12,26"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"/>

            <TextBlock Text="© AHQ Softwares"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="12"
                       Margin="12"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"/>

            <TextBlock Text="Proudly Open Sourced!"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="12"
                       Margin="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"/>


            <Button Click="Open_License"
                    Style="{DynamicResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Let's start"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE8AD;"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>

        <Grid x:Name="License"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform Y="30"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="10"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="12,40,0,20"
                        HorizontalAlignment="Center">

                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,5,5,0"
                           HorizontalAlignment="Center"
                           Text="&#xE774;"/>
                <TextBlock
                    Text="Open Sourced License"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>


                <TextBlock Text="• AHQ Store is open source software under the MIT License."/>
                <TextBlock Text="• You’re free to use, modify, and distribute it."/>
                <TextBlock Text="• No hidden restrictions. No funny business"/>
                <TextBlock Text="• Open source means transparency — you can audit our code anytime."/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="Transparent"
                    Margin="12">
                <Expander Header="Full MIT License Text"
                          VerticalAlignment="Bottom">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Visible">

                        <TextBlock x:Name="LicenseText"
                                   Text="Water is granted for free to all humans. Let it  be application developers"
                                   TextWrapping="Wrap"
                                   FontFamily="monospace"
                                   Padding="10"
                                   Margin="2"/>
                    </ScrollViewer>
                </Expander>
            </Border>

            <CheckBox
                Grid.Row="4"
                x:Name="agree"
                Content="I agree to the MIT License"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Margin="12,10,12,15"/>

            <Button Grid.Row="4"
                    Margin="12,10,12,15"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding ElementName=agree, Path=IsChecked}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="Open_Terms">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Agree &amp; Continue"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE974;"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <StackPanel Grid.Row="5"
                        VerticalAlignment="Bottom"
                        Margin="12,0,12,12"
                        Orientation="Horizontal"
                        Width="800">
                <TextBlock Text="Step 1 of 5 · License"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12"/>

            </StackPanel>

            <ProgressBar Grid.Row="5"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Right"
                         Margin="12,0,12,12"
                         Value="20"
                         Width="320"/>

        </Grid>

        <Grid x:Name="Terms"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform Y="30"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="10"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="12,30,0,10"
                        HorizontalAlignment="Center">

                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,5,5,0"
                           HorizontalAlignment="Center"
                           Text="&#xE95A;"/>

                <TextBlock
                    Text="Terms you abide by"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>


                <TextBlock Text="• Open-source and transparent under the MIT License."/>
                <TextBlock Text="• You are free to use, modify, and audit our code anytime."/>
                <TextBlock Text="• Use at your own risk; we do not guarantee third-party app safety."/>
                <TextBlock Text="• Malicious use or distributing malware results in a permanent ban."/>
                <TextBlock Text="• Intended users: 21+. Community content is best-effort reviewed; not guaranteed."
                           TextWrapping="Wrap"
                           MaxWidth="450"/>
                <TextBlock Text="• This is a summary; only the text below is legally binding."
                           FontWeight="Bold"/>
            </StackPanel>


            <Border Grid.Row="2"
                    Margin="12">
                <Expander Header="Our Terms of Service"
                          IsExpanded="True"
                          VerticalAlignment="Bottom">

                    <FlowDocumentScrollViewer Margin="10,0"
                                              BorderThickness="10">
                        <FlowDocument FontFamily="Segoe UI Variable"
                                      FontSize="14"
                                      x:Name="TermsOfService">
                        </FlowDocument>
                    </FlowDocumentScrollViewer>
                </Expander>
            </Border>

            <CheckBox
                Grid.Row="4"
                x:Name="agree2"
                Content="I have thoroughly read, understood and agreed to the terms."
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Margin="12,10,12,15"/>

            <Button Grid.Row="4"
                    Margin="12,10,12,15"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding ElementName=agree2, Path=IsChecked}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="Launch_PP">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Agree &amp; Continue"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE974;"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>


            <StackPanel Grid.Row="5"
                        VerticalAlignment="Bottom"
                        Margin="12,0,12,12"
                        Orientation="Horizontal"
                        Width="800">
                <TextBlock Text="Step 2 of 5 · Terms of Service"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12"/>

            </StackPanel>

            <ProgressBar Grid.Row="5"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Right"
                         Margin="12,0,12,12"
                         Value="40"
                         Width="320"/>
        </Grid>

        <Grid x:Name="PrivacyPolicy"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform Y="30"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="10"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="12,30,0,10"
                        HorizontalAlignment="Center">

                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,5,5,0"
                           HorizontalAlignment="Center"
                           Text="&#xE928;"/>
                <TextBlock
                    Text="Our Privacy Stance"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0"/>


                <TextBlock Text="• We do not collect any data from your local machine automatically."/>
                <TextBlock Text="• Only data you voluntarily submit via GitHub is collected."/>
                <TextBlock Text="• Submissions are public and permanent due to Git history nature."/>
                <TextBlock Text="• We do not sell or trade your personally identifiable information."/>
                <TextBlock Text="• Signing in to AHQ Store is absolutely not necessary."/>
                <TextBlock Text="• This is a summary; only the text below is legally binding."
                           FontWeight="Bold"/>
            </StackPanel>


            <Border Grid.Row="2"
                    Margin="12">
                <Expander Header="Our Privacy Policy"
                          IsExpanded="True"
                          VerticalAlignment="Bottom">

                    <FlowDocumentScrollViewer Margin="10,0"
                                              BorderThickness="10">
                        <FlowDocument FontFamily="Segoe UI Variable"
                                      FontSize="14"
                                      x:Name="PrivacyPolicyMarkdown">
                        </FlowDocument>
                    </FlowDocumentScrollViewer>
                </Expander>
            </Border>

            <CheckBox
                Grid.Row="4"
                x:Name="agree3"
                Content="I have thoroughly read and understood your privacy policy."
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Margin="12,10,12,15"/>

            <Button Grid.Row="4"
                    Margin="12,10,12,15"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding ElementName=agree3, Path=IsChecked}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="ArchitectureSelect">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="I understand"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE8FB;"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>


            <StackPanel Grid.Row="5"
                        VerticalAlignment="Bottom"
                        Margin="12,0,12,12"
                        Orientation="Horizontal"
                        Width="800">
                <TextBlock Text="Step 3 of 5 · Privacy Policy"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12"/>

            </StackPanel>

            <ProgressBar Grid.Row="5"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Right"
                         Margin="12,0,12,12"
                         Value="60"
                         Width="320"/>

        </Grid>

        <Grid x:Name="Configuration"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform Y="30"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="10"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="12,30,0,20"
                        HorizontalAlignment="Center">

                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,5,5,0"
                           HorizontalAlignment="Center"
                           Text="&#xE81E;"/>
                <TextBlock
                    Text="Let's customize your installation"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"/>
            </StackPanel>


            <Border Grid.Row="1"
                    Margin="12">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Which flavour suits you best?"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <ComboBox MinWidth="250"
                              HorizontalAlignment="Center"
                              Margin="0,2,0,30"
                              x:Name="ReleaseChannel"
                              SelectedIndex="0"
                              SelectionChanged="ReleaseChannel_Changed">
                        <ComboBoxItem Content="Up to date Stable"/>
                        <ComboBoxItem Content="Absolute Latest Available"/>
                    </ComboBox>

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Left"
                                Width="400"
                                Margin="0,25,0,0">
                        <CheckBox Content="Use AHQ Store Fluent"
                                  IsChecked="True"
                                  IsEnabled="False"
                                  Margin="0,0,0,5"/>

                        <CheckBox Content="Start AHQ Store after install"
                                  x:Name="StartAfterInstall"
                                  IsChecked="True"/>

                        <CheckBox Content="Install AHQ Store Elevated Updater (soon)"
                                  IsChecked="False"
                                  IsEnabled="False"
                                  ToolTipService.InitialShowDelay="100"
                                  ToolTipService.Placement="MousePoint"
                                  ToolTipService.ToolTip="This allows seamless updates for System Wide Installed Applications when an Administrator User logs on to the computer. This is currently being thought of and has no implications yet."/>


                        <ProgressBar IsIndeterminate="True"
                                     Margin="0,40,0,0"
                                     HorizontalAlignment="Center"
                                     x:Name="ProgressStatus"/>

                        <TextBlock
                            Text="{Binding statusText}"
                            HorizontalAlignment="Center"
                            x:Name="CheckStatusInformativeText"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>


                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Grid.Row="3"
                    Margin="12,10,12,15"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding installEnabled}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="Launch_Install">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Install"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE74B;"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>


            <StackPanel Grid.Row="4"
                        VerticalAlignment="Bottom"
                        Margin="12,0,12,12"
                        Orientation="Horizontal"
                        Width="800">
                <TextBlock Text="Step 4 of 5 · Configuration"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12"/>

            </StackPanel>

            <ProgressBar Grid.Row="4"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Right"
                         Margin="12,0,12,12"
                         Value="80"
                         Width="320"/>
        </Grid>

        <Grid x:Name="Installing"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform Y="30"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="10"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="12,30,0,20"
                        HorizontalAlignment="Center">

                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,5,5,0"
                           HorizontalAlignment="Center"
                           Text="&#xE81E;"/>
                <TextBlock
                    Text="We're installing"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"/>
            </StackPanel>


            <Border Grid.Row="1"
                    Margin="12">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <ProgressBar IsIndeterminate="True"
                                 Margin="0,40,0,0"
                                 HorizontalAlignment="Center"
                                 x:Name="InstallingProgressStatus"
                                 Width="600"/>

                    <TextBlock
                        Text="{Binding installingStatusText}"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Margin="0,25,0,0"/>

                </StackPanel>
            </Border>


            <StackPanel Grid.Row="4"
                        VerticalAlignment="Bottom"
                        Margin="12,0,12,12"
                        Orientation="Horizontal"
                        Width="800">
                <TextBlock Text="Installing"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12"/>

            </StackPanel>
        </Grid>

        <Grid x:Name="Installed"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform Y="30"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="10"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="12,50,0,20"
                        HorizontalAlignment="Center">

                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="100"
                           FontWeight="SemiBold"
                           Margin="0,5,5,0"
                           HorizontalAlignment="Center"
                           Text="&#xf32a;"/>
                <TextBlock
                    Text="AHQ Store is installed!"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"/>
            </StackPanel>


            <Border Grid.Row="1"
                    Margin="12">
                <TextBlock Text="Now you can close this installer!"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <Button Grid.Row="3"
                    Margin="12,10,12,15"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="Close_App">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Close"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xf3b1;"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>


            <StackPanel Grid.Row="4"
                        VerticalAlignment="Bottom"
                        Margin="12,0,12,12"
                        Orientation="Horizontal"
                        Width="800">
                <TextBlock Text="Step 5 of 5 · Installed"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12"/>

            </StackPanel>

            <ProgressBar Grid.Row="4"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Right"
                         Margin="12,0,12,12"
                         Value="100"
                         Width="320"/>
        </Grid>

        <Grid x:Name="Installation"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform Y="30"/>
            </Grid.RenderTransform>
            <TextBlock Text="This is Grid B"/>
        </Grid>
    </Grid>
</Window>
